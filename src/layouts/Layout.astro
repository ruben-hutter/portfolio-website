---
export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "Ruben Hutter's portfolio — MSE student in Information & Cyber Security at FHNW.", lang = 'en' } = Astro.props;

import '../styles/global.css';
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline src="/scripts/theme-init.js"></script>
    <script is:inline src="/scripts/theme.js" defer></script>
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-white transition-colors">
    <slot />
  </body>
</html>
