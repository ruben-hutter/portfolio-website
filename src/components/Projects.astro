---
import { projects } from '../data/projects';
import { useTranslations, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="projects" class="py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-4">
      <span class="text-green-500 dark:text-green-400 font-mono text-xl">// </span>{t('projects.heading')}
    </h2>
    <div class="w-16 h-1 bg-green-500 mx-auto mb-12 rounded-full"></div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden hover:shadow-md hover:border-green-500/50 dark:hover:border-green-400/50 transition-all flex flex-col">
          <div class="flex items-center px-4 py-2 bg-gray-50 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 font-mono text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap overflow-hidden">
            <span class="text-green-500 dark:text-green-400 mr-1">$</span> cat ~/projects/<span class="text-gray-600 dark:text-gray-300">{project.slug}</span>/README.md
          </div>
          <div class="p-6 flex-1 flex flex-col">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{t(`projects.${project.slug}.title`)}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 flex-1">{t(`projects.${project.slug}.description`)}</p>
            <div class="flex flex-wrap gap-2 mb-4">
              {project.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded">
                  {tag}
                </span>
              ))}
            </div>
            <div class="flex gap-3">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-mono text-green-500 hover:text-green-600 dark:text-green-400 dark:hover:text-green-300 font-medium"
                >
                  {t('projects.githubLink')}
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm font-mono text-green-500 hover:text-green-600 dark:text-green-400 dark:hover:text-green-300 font-medium"
                >
                  {t('projects.demoLink')}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
