---
import { skillGroups } from '../data/skills';
import { useTranslations, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const bio = t('profile.bio') as string[];
---

<section id="about" class="py-20 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-4">
      <span class="text-green-500 dark:text-green-400 font-mono text-xl">// </span>{t('about.heading')}
    </h2>
    <div class="w-16 h-1 bg-green-500 mx-auto mb-12 rounded-full"></div>

    <div class="max-w-3xl mx-auto mb-16">
      {bio.map((paragraph: string) => (
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4 text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <h3 class="text-xl font-semibold text-center text-gray-900 dark:text-white mb-8">
      <span class="text-green-500 dark:text-green-400 font-mono text-sm">// </span>{t('about.skillsHeading')}
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillGroups.map((group) => (
        <div class="bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
          <h4 class="font-semibold text-gray-900 dark:text-white mb-3">{t(`skills.${group.slug}`)}</h4>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-xs font-mono px-2 py-1 bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-400 rounded whitespace-nowrap">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
