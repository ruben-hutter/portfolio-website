---
import { profile } from '../data/profile';
import { skillGroups } from '../data/skills';
---

<section id="about" class="py-20 bg-gray-50 dark:bg-gray-800/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-3xl font-bold text-center text-gray-900 dark:text-white mb-4">About Me</h2>
    <div class="w-16 h-1 bg-indigo-500 mx-auto mb-12 rounded-full"></div>

    <div class="max-w-3xl mx-auto mb-16">
      {profile.bio.map((paragraph) => (
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4 text-center">
          {paragraph}
        </p>
      ))}
    </div>

    <h3 class="text-xl font-semibold text-center text-gray-900 dark:text-white mb-8">Skills & Technologies</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillGroups.map((group) => (
        <div class="bg-white dark:bg-gray-900 rounded-xl p-6 shadow-sm border border-gray-200 dark:border-gray-700">
          <h4 class="font-semibold text-gray-900 dark:text-white mb-3">{group.category}</h4>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-xs px-2.5 py-1 bg-indigo-50 dark:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 rounded-full">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
