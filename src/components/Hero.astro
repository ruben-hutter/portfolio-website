---
import { profile } from '../data/profile';
import { useTranslations, type Lang } from '../i18n/utils';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="home" class="min-h-screen flex items-center pt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-20">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="flex-1 text-center md:text-left">
        <p class="text-indigo-500 dark:text-indigo-400 font-medium mb-2">{t('hero.greeting')}</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-4">
          {profile.name}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
          {t('profile.tagline')}
        </p>
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          <a
            href="#projects"
            class="inline-flex items-center px-6 py-3 bg-indigo-500 text-white rounded-lg hover:bg-indigo-600 transition-colors font-medium"
          >
            {t('hero.viewWork')}
          </a>
          <a
            href="#contact"
            class="inline-flex items-center px-6 py-3 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 rounded-lg hover:border-indigo-500 dark:hover:border-indigo-400 transition-colors font-medium"
          >
            {t('hero.getInTouch')}
          </a>
        </div>
      </div>
      <div class="flex-shrink-0">
        <img
          src={profile.profileImage}
          alt={profile.name}
          class="w-64 h-64 rounded-full object-cover shadow-xl ring-4 ring-indigo-500/20"
        />
      </div>
    </div>
  </div>
</section>
